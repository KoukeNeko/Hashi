#!/bin/bash
# ==============================================================================
# Hashi Post-Installation Script
# ==============================================================================

set -e

echo ""
echo "╔══════════════════════════════════════════════════════════════════╗"
echo "║   📦  Hashi Post-Installation                                    ║"
echo "╚══════════════════════════════════════════════════════════════════╝"
echo ""

# -----------------------------------------------------------------------------
# 1. Create dedicated user
# -----------------------------------------------------------------------------
echo "👤 Creating hashi user..."
if ! id "hashi" &>/dev/null; then
    useradd -r -s /bin/bash -m -d /opt/hashi-home hashi
    echo "   ✅ User 'hashi' created"
else
    echo "   ✅ User 'hashi' already exists"
fi

# -----------------------------------------------------------------------------
# 2. Add user to necessary groups
# -----------------------------------------------------------------------------
echo "👥 Adding user to groups..."
usermod -aG docker hashi 2>/dev/null || true
usermod -aG libvirt hashi 2>/dev/null || true
usermod -aG kvm hashi 2>/dev/null || true
echo "   ✅ Added to docker, libvirt, kvm groups"

# -----------------------------------------------------------------------------
# 3. Create sudoers configuration
# -----------------------------------------------------------------------------
echo "🔐 Setting up sudo permissions..."
cat > /etc/sudoers.d/hashi << 'EOF'
# Hashi Server Management Dashboard - Sudo Permissions
# This file grants the hashi user passwordless sudo access to manage system resources

# System service management
hashi ALL=(ALL) NOPASSWD: /usr/bin/systemctl

# Firewall management (iptables and ufw)
hashi ALL=(ALL) NOPASSWD: /usr/sbin/iptables, /usr/sbin/iptables-save, /usr/sbin/iptables-restore
hashi ALL=(ALL) NOPASSWD: /usr/sbin/netfilter-persistent
hashi ALL=(ALL) NOPASSWD: /usr/sbin/ufw

# Nginx management
hashi ALL=(ALL) NOPASSWD: /usr/sbin/nginx

# SSL certificate management
hashi ALL=(ALL) NOPASSWD: /usr/bin/certbot

# File operations (for config file management)
hashi ALL=(ALL) NOPASSWD: /usr/bin/tee, /usr/bin/rm, /usr/bin/ln, /usr/bin/mkdir, /usr/bin/chown, /usr/bin/chmod

# User management (for FTP users)
hashi ALL=(ALL) NOPASSWD: /usr/sbin/useradd, /usr/sbin/userdel, /usr/sbin/usermod, /usr/sbin/chpasswd

# User info (for listing users)
hashi ALL=(ALL) NOPASSWD: /usr/bin/getent, /usr/bin/passwd

# Update check
hashi ALL=(ALL) NOPASSWD: /usr/bin/apt-get update
EOF
chmod 0440 /etc/sudoers.d/hashi
echo "   ✅ Sudoers configuration created"

# -----------------------------------------------------------------------------
# 4. Create systemd service
# -----------------------------------------------------------------------------
echo "⚙️ Creating systemd service..."

# Detect installed package by looking for the executable in /opt
# jpackage installs to /opt/{package-name}/bin/{package-name}
# We look for directories matching /opt/hashi* that contain a bin directory
EXEC_PATH=""
for dir in /opt/hashi*/bin; do
    if [ -d "$dir" ]; then
        # Find the executable in this bin directory
        for exe in "$dir"/*; do
            if [ -x "$exe" ] && [ -f "$exe" ]; then
                EXEC_PATH="$exe"
                break 2
            fi
        done
    fi
done

# Fallback if nothing found
if [ -z "$EXEC_PATH" ]; then
    EXEC_PATH="/opt/hashi/bin/hashi"
    echo "   ⚠️ Could not detect executable, using default: $EXEC_PATH"
fi

cat > /etc/systemd/system/hashi.service << EOF
[Unit]
Description=Hashi Server Management Dashboard
After=network.target

[Service]
Type=simple
User=hashi
Group=hashi
ExecStart=${EXEC_PATH}
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
echo "   ✅ Systemd service created (ExecStart: ${EXEC_PATH})"

# -----------------------------------------------------------------------------
# 5. Enable and start service
# -----------------------------------------------------------------------------
echo "🚀 Starting service..."
systemctl daemon-reload
systemctl enable hashi
systemctl restart hashi || true
echo "   ✅ Service enabled and started"

# -----------------------------------------------------------------------------
# 6. Display success message
# -----------------------------------------------------------------------------
echo ""
echo "╔══════════════════════════════════════════════════════════════════╗"
echo "║   🎉  Hashi Installed Successfully!                              ║"
echo "╚══════════════════════════════════════════════════════════════════╝"
echo ""
echo "📦 Service Info:"
echo "   • Service Name: hashi"
echo "   • Install Path: /opt/hashi"
echo "   • Run As User:  hashi"
echo ""
echo "🔧 Useful Commands:"
echo "   • Check status:  sudo systemctl status hashi"
echo "   • View logs:     sudo journalctl -u hashi -f"
echo "   • Restart:       sudo systemctl restart hashi"
echo ""
echo "🌐 Access:"
IP=$(hostname -I | awk '{print $1}')
[ -z "$IP" ] && IP="localhost"
echo "   • Dashboard:     http://$IP:3847"
echo "   • Health Check:  http://$IP:3847/actuator/health"
echo ""

# Display service status
echo "📊 Current Service Status:"
systemctl status hashi --no-pager -l 2>/dev/null || echo "   ⚠️ Service may still be starting..."
echo ""