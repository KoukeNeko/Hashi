#!/bin/bash
# ==============================================================================
# Hashi Post-Installation Script
# ==============================================================================

set -e

echo ""
echo "╔══════════════════════════════════════════════════════════════════╗"
echo "║   📦  Hashi Post-Installation                                    ║"
echo "╚══════════════════════════════════════════════════════════════════╝"
echo ""

# -----------------------------------------------------------------------------
# 1. Create dedicated user
# -----------------------------------------------------------------------------
echo "👤 Creating hashi user..."
if ! id "hashi" &>/dev/null; then
    useradd -r -s /bin/bash -m -d /opt/hashi-home hashi
    echo "   ✅ User 'hashi' created"
else
    echo "   ✅ User 'hashi' already exists"
fi

# -----------------------------------------------------------------------------
# 2. Add user to necessary groups
# -----------------------------------------------------------------------------
echo "👥 Adding user to groups..."
usermod -aG docker hashi 2>/dev/null || true
usermod -aG libvirt hashi 2>/dev/null || true
usermod -aG kvm hashi 2>/dev/null || true
echo "   ✅ Added to docker, libvirt, kvm groups"

# -----------------------------------------------------------------------------
# 3. Create sudoers configuration
# -----------------------------------------------------------------------------
echo "🔐 Setting up sudo permissions..."
cat > /etc/sudoers.d/hashi << 'EOF'
# Allow hashi user to manage system resources without password
hashi ALL=(ALL) NOPASSWD: /usr/sbin/iptables, /usr/bin/systemctl, /usr/bin/su, /usr/bin/getent
EOF
chmod 0440 /etc/sudoers.d/hashi
echo "   ✅ Sudoers configuration created"

# -----------------------------------------------------------------------------
# 4. Create systemd service
# -----------------------------------------------------------------------------
echo "⚙️ Creating systemd service..."

# Determine package name and executable path dynamically
# DPKG_MAINTSCRIPT_PACKAGE is set by dpkg during installation
PKG_NAME="${DPKG_MAINTSCRIPT_PACKAGE:-hashi}"
EXEC_PATH="/opt/${PKG_NAME}/bin/${PKG_NAME}"

cat > /etc/systemd/system/hashi.service << EOF
[Unit]
Description=Hashi Server Management Dashboard
After=network.target

[Service]
Type=simple
User=hashi
Group=hashi
ExecStart=${EXEC_PATH}
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
echo "   ✅ Systemd service created (ExecStart: ${EXEC_PATH})"

# -----------------------------------------------------------------------------
# 5. Enable and start service
# -----------------------------------------------------------------------------
echo "🚀 Starting service..."
systemctl daemon-reload
systemctl enable hashi
systemctl restart hashi || true
echo "   ✅ Service enabled and started"

# -----------------------------------------------------------------------------
# 6. Display success message
# -----------------------------------------------------------------------------
echo ""
echo "╔══════════════════════════════════════════════════════════════════╗"
echo "║   🎉  Hashi Installed Successfully!                              ║"
echo "╚══════════════════════════════════════════════════════════════════╝"
echo ""
echo "📦 Service Info:"
echo "   • Service Name: hashi"
echo "   • Install Path: /opt/hashi"
echo "   • Run As User:  hashi"
echo ""
echo "🔧 Useful Commands:"
echo "   • Check status:  sudo systemctl status hashi"
echo "   • View logs:     sudo journalctl -u hashi -f"
echo "   • Restart:       sudo systemctl restart hashi"
echo ""
echo "🌐 Access:"
IP=$(hostname -I | awk '{print $1}')
[ -z "$IP" ] && IP="localhost"
echo "   • Dashboard:     http://$IP:3847"
echo "   • Health Check:  http://$IP:3847/actuator/health"
echo ""

# Display service status
echo "📊 Current Service Status:"
systemctl status hashi --no-pager -l 2>/dev/null || echo "   ⚠️ Service may still be starting..."
echo ""